cabal-version:      3.0
name:               dessins
version:            0.1.0.0
build-type:         Simple

-- Environment scaffold for reproducing geometric drawings from the
-- Delahaye books. Each task gets its own executable under app/,
-- following the pattern shown in app/Example.hs.

common shared
    ghc-options:      -Wall
    default-language: Haskell2010

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:
        Dessins
      , Dessins.Utils
      , Dessins.Utils.Grid
      , Dessins.Utils.Polygon
      , Dessins.Utils.Scene
      , Dessins.Const
      , Dessins.Types
      , Dessins.Figures

      , Dessins.Figures.Build
      , Dessins.Figures.Build.Registry
      
      , Dessins.Figures.PolygonesReguliers
      , Dessins.Figures.PolygonesReguliers.Common
      , Dessins.Figures.PolygonesReguliers.Figure001
      , Dessins.Figures.PolygonesReguliers.Figure002
      , Dessins.Figures.PolygonesReguliers.Figure003
      , Dessins.Figures.PolygonesReguliers.Figure004
      , Dessins.Figures.PolygonesReguliers.Figure005
      , Dessins.Figures.PolygonesReguliers.Figure006

      , Dessins.Figures.EtoilesRegulieres
      , Dessins.Figures.EtoilesRegulieres.Common
      , Dessins.Figures.EtoilesRegulieres.Figure007
      , Dessins.Figures.EtoilesRegulieres.Figure008
      , Dessins.Figures.EtoilesRegulieres.Figure009
      , Dessins.Figures.EtoilesRegulieres.Figure010
      , Dessins.Figures.EtoilesRegulieres.Figure011
      , Dessins.Figures.EtoilesRegulieres.Figure012

      , Dessins.Figures.Composition1
      , Dessins.Figures.Composition1.Common
      , Dessins.Figures.Composition1.Figure013
      , Dessins.Figures.Composition1.Figure014
      , Dessins.Figures.Composition1.Figure015
      , Dessins.Figures.Composition1.Figure016
      , Dessins.Figures.Composition1.Figure017
      , Dessins.Figures.Composition1.Figure018
      , Dessins.Figures.Composition1.Figure019

      , Dessins.Figures.Composition2
      , Dessins.Figures.Composition2.Common
      , Dessins.Figures.Composition2.Figure020
      , Dessins.Figures.Composition2.Figure021
      , Dessins.Figures.Composition2.Figure022
      , Dessins.Figures.Composition2.Figure023
      , Dessins.Figures.Composition2.Figure024
      , Dessins.Figures.Composition2.Figure025

      , Dessins.Figures.Joligones
      , Dessins.Figures.Joligones.Common
      , Dessins.Figures.Joligones.Figure026
      , Dessins.Figures.Joligones.Figure027
      , Dessins.Figures.Joligones.Figure028
      , Dessins.Figures.Joligones.Figure029
      , Dessins.Figures.Joligones.Figure030
      , Dessins.Figures.Joligones.Figure031
      , Dessins.Figures.Joligones.Figure032
      , Dessins.Figures.Joligones.Figure033

      , Dessins.Figures.Cheval
      , Dessins.Figures.Cheval.Common
      , Dessins.Figures.Cheval.Figure034
      , Dessins.Figures.Cheval.Figure035
      , Dessins.Figures.Cheval.Figure036
      , Dessins.Figures.Cheval.Figure037
      , Dessins.Figures.Cheval.Figure038
      , Dessins.Figures.Cheval.Figure039
      , Dessins.Figures.Cheval.Figure040
      , Dessins.Figures.Cheval.Figure041
      , Dessins.Figures.Cheval.Figure042
      , Dessins.Figures.Cheval.Figure043

      , Dessins.Figures.Lion
      , Dessins.Figures.Lion.Common
      , Dessins.Figures.Lion.Figure044
      , Dessins.Figures.Lion.Figure045

      , Dessins.Figures.OiseauxPoissons
      , Dessins.Figures.OiseauxPoissons.Common
      , Dessins.Figures.OiseauxPoissons.Figure046
      , Dessins.Figures.OiseauxPoissons.Figure047

      , Dessins.Figures.Smurf
      , Dessins.Figures.Smurf.Common
      , Dessins.Figures.Smurf.Figure048

      , Dessins.Figures.Bonus
      , Dessins.Figures.Bonus.Bonus
      , Dessins.Figures.Bonus.FigureDragon
      , Dessins.Figures.Bonus.TriangleFigure
    build-depends:
        base >=4 && <5
      , diagrams-lib
      , diagrams-svg
      , containers

executable main
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:
        base >=4 && <5
      , dessins
      , diagrams-lib
      , diagrams-svg

executable dessins-build
    import:           shared
    main-is:          BuildSvg.hs
    hs-source-dirs:   app
    build-depends:
        base >=4 && <5
      , dessins
      , diagrams-lib
      , diagrams-svg
