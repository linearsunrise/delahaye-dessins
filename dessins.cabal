cabal-version:      3.0
name:               dessins
version:            0.1.0.0
build-type:         Simple

-- Environment scaffold for reproducing geometric drawings from the
-- Delahaye books. Each task gets its own executable under app/,
-- following the pattern shown in app/Example.hs.

common shared
    ghc-options:      -Wall
    default-language: Haskell2010

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:
        Dessins
      , Dessins.Utils
      , Dessins.Utils.Grid
      , Dessins.Utils.Polygon
      , Dessins.Utils.Scene
      , Dessins.Const
      , Dessins.Types
      , Dessins.Figures
      , Dessins.Figures.PolygonesReguliers
      , Dessins.Figures.EtoilesRegulieres
      , Dessins.Figures.Composition1
      , Dessins.Figures.Composition2
    build-depends:
        base >=4 && <5
      , diagrams-lib
      , diagrams-svg

executable main
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:
        base >=4 && <5
      , dessins
      , diagrams-lib
      , diagrams-svg
