cabal-version:      3.0
name:               dessins
version:            0.1.0.0
build-type:         Simple

-- Environment scaffold for reproducing geometric drawings from the
-- Delahaye books. Each task gets its own executable under app/,
-- following the pattern shown in app/Example.hs.

common shared
    ghc-options:      -Wall
    default-language: Haskell2010

executable example
    import:           shared
    main-is:          Example.hs
    hs-source-dirs:   app
    build-depends:
        base >=4 && <5
      , diagrams-lib
      , diagrams-rasterific

executable example-svg
    import:           shared
    main-is:          ExampleSvg.hs
    hs-source-dirs:   app
    build-depends:
        base >=4 && <5
      , diagrams-lib
      , diagrams-svg

executable dessins-01
    import:           shared
    main-is:          Dessins01.hs
    hs-source-dirs:   app
    build-depends:
        base >=4 && <5
      , diagrams-lib
      , diagrams-svg
